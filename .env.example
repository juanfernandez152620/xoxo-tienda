# Ajustes de la tienda. Copiá este archivo como .env y completalo.
# El archivo .env es secreto: no lo subas a GitHub ni lo compartas.

# Dirección pública de la tienda (con https). Sirve para volver de la pasarela y para que
# GO cuotas y Mercado Pago avisen los pagos.
BASE_URL=http://localhost:3000
PORT=3000

# Carpeta de los datos: contenido editado en /admin, estadísticas, registro, pedidos y fotos subidas.
# En el servidor conviene una carpeta fuera del código (ej. /var/lib/xoxo-tienda) para que una actualización no la pise.
DATOS=datos

# true si adelante hay un nginx o Cloudflare: así se guarda la IP real de cada visitante
DETRAS_DE_PROXY=false

# Cada cuántas horas se guarda una copia de las estadísticas
BACKUP_HORAS=1

# ---- Mercado Pago ----
# mercadopago.com.ar/developers → Tus integraciones → (tu aplicación) → Credenciales de producción → Access Token
# Para probar sin cobrar de verdad usá el Access Token de prueba (empieza con TEST-).
MP_ACCESS_TOKEN=

# ---- GO cuotas ----
# Usuario de sucursal: en el panel de GO cuotas → Otros → Sucursales → Nueva.
# Pedí a integraciones@gocuotas.com que habiliten la "API Redirect V1" para esa sucursal.
GOCUOTAS_EMAIL=
GOCUOTAS_PASSWORD=
# true = usa el entorno de prueba de GO cuotas (sandbox.gocuotas.com)
GOCUOTAS_SANDBOX=false

# true = los medios de pago que todavía no tienen clave muestran un pago simulado (para probar la web).
# Ponelo en false antes de publicar la tienda. Sin ningún medio activo, la tienda funciona solo con WhatsApp.
PAGOS_DEMO=false
