# Ajustes de la tienda. Copiá este archivo como .env y completalo.
# El archivo .env es secreto: no lo subas a GitHub ni lo compartas.

# Dirección pública de la tienda (con https). Sirve para volver de la pasarela y para que
# GO cuotas y Mercado Pago avisen los pagos.
BASE_URL=http://localhost:3000
PORT=3000

# Carpeta de los datos: contenido editado en /admin, estadísticas, registro, pedidos y fotos subidas.
# En el servidor conviene una carpeta fuera del código (ej. /var/lib/xoxo-tienda) para que una actualización no la pise.
DATOS=datos

# true si adelante hay un nginx o Cloudflare: así se guarda la IP real de cada visitante
DETRAS_DE_PROXY=false

# Cada cuántas horas se guarda una copia de las estadísticas
BACKUP_HORAS=1

# ---- Mercado Pago ----
# mercadopago.com.ar/developers → Tus integraciones → (tu aplicación) → Credenciales de producción → Access Token
# Para probar sin cobrar de verdad usá "Credenciales de prueba" (las de la cuenta vendedora de prueba).
MP_ACCESS_TOKEN=

# ---- GO cuotas ----
# Email de la sucursal y, como contraseña, su API key (panel de GO cuotas → Sucursales → Editar →
# "Ver ApiKeys de la sucursal"). La de sandbox va con GOCUOTAS_SANDBOX=true; la de producción, con false.
# Si no anda, pedí a integraciones@gocuotas.com que habiliten la "API Redirect V1" para esa sucursal.
GOCUOTAS_EMAIL=
GOCUOTAS_PASSWORD=
# true = usa el entorno de prueba de GO cuotas (sandbox.gocuotas.com)
GOCUOTAS_SANDBOX=false

# true = los medios de pago que todavía no tienen clave muestran un pago simulado (para probar la web).
# Ponelo en false antes de publicar la tienda. Sin ningún medio activo, la tienda funciona solo con WhatsApp.
PAGOS_DEMO=false

# ---- Claude: contesta solo el chat "Cambios por IA" del panel ----
# API key de console.anthropic.com (se paga por uso). Sin clave, el chat no contesta solo.
# En el servidor se carga con xoxo-claves.
ANTHROPIC_API_KEY=
# Modelo (por defecto Claude Opus 5.5)
CLAUDE_MODELO=claude-opus-5-5

# ---- WhatsApp del socio (API de WhatsApp Business de Meta) ----
# En el servidor se cargan con xoxo-claves (ver deploy/LEEME.md). Webhook: BASE_URL/api/socio/whatsapp
WA_PHONE_ID=
WA_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
# Quiénes pueden escribirle: Nombre:número, separados por coma (ej: Juan:3815616404,Socio:3811234567)
SOCIO_NUMEROS=

# ---- Correo de la tienda (aviso de compra al cliente y de venta a la tienda) ----
# SMTP de cualquier proveedor (ver deploy/CORREO.md). Sin SMTP, los mails se guardan y se ven en el panel.
# En el servidor se cargan con xoxo-claves, opción 6.
SMTP_HOST=
# 587 con starttls (lo normal) o 465 con tls
SMTP_PUERTO=587
SMTP_SEGURO=starttls
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_DE="XOXO Tecno <ventas@xoxotecno.com.ar>"
# Opcional: a dónde van las respuestas del cliente
CORREO_RESPONDER=
# A quiénes avisar cada venta, separados por coma
CORREO_AVISOS=ventas@xoxotecno.com.ar
